# Wygeneruj losowy klucz: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Ustaw tę samą zmienną w Vercel. Nie używaj prefiksu NEXT_PUBLIC_.
WEBMAIL_SECRET=

# Klucz API z Resend. Domena ccconsulting.pl musi być zweryfikowana w Resend.
RESEND_API_KEY=

# Vercel tworzy poniższe zmienne po połączeniu prywatnego Blob z projektem.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
